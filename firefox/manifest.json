{
  "manifest_version": 3,
  "name": "Zendesk Markdown Paste",
  "version": "1.0.0",
  "description": "Converts markdown to rich text when pasting into Zendesk comment fields.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zendesk-markdown-paste@chiph",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["https://*.zendesk.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
